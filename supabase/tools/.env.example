# ============================================================================
#  Konfigurasi skrip migrasi. SALIN file ini menjadi `.env` lalu isi.
#
#  JANGAN pernah commit file `.env` ke git - isinya berisi kunci yang
#  memberi akses penuh ke database.
# ============================================================================

# ---------- Supabase ----------
# Taruh: Project Settings -> API

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Kunci "anon public". Dipakai hanya untuk memanggil fungsi laporan sebagai
# pengguna anonim, supaya kita bisa menguji jalur yang dipakai pengunjung.
SUPABASE_ANON_KEY=eyJhbGci...

# Kunci "service_role". Memberi akses penuh, melewati Row Level Security.
# Hanya skrip migrasi yang memakainya. JANGAN pernah ditaruh di HTML atau JS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---------- Google service account ----------
# Lihat README.md bagian "Membuat service account".
# GOOGLE_CLIENT_EMAIL adalah akun.robot@project.iam.gserviceaccount.com
# Ini BUKAN email admin RW Anda.

GOOGLE_CLIENT_EMAIL=akun-robot@project.iam.gserviceaccount.com

# Tempel private key persis seperti di unduhan JSON, satu baris panjang.
# Newline asli harus ditulis sebagai \n (caranya ada di README.md).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

