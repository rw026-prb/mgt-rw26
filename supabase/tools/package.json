{
  "name": "rw026-supabase-tools",
  "private": true,
  "type": "module",
  "description": "Alat migrasi dan pengujian Portal RW 026 (Google Sheets -> Supabase)",
  "scripts": {
    "test": "node test-lib.mjs && node test-migrate.mjs && node test-privkey.mjs && node test-pantulan.mjs && node test-audit-password.mjs",
    "test:sql": "node validate-migrations.cjs",
    "test:kas": "node test-ganti-password.mjs",
    "test:rahasia": "node cek-rahasia.mjs",
    "test:privkey": "node test-privkey.mjs",
    "audit:gitignore": "node audit-gitignore.mjs",
    "audit:github": "node audit-github.mjs",
    "audit": "npm run audit:gitignore && npm run test:rahasia && npm run audit:github",
    "cek:aksi": "node cek-aksi.mjs",
    "smoke": "node smoke.mjs",
    "migrate:dry": "node migrate.mjs --dry-run",
    "split": "node split-codegs.mjs",
    "split:apply": "node split-codegs.mjs --apply"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "embedded-postgres": "^17.5.0-beta.15",
    "pg": "^8.16.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64": true
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jsdom": "^30.1.1"
  }
}
